# ==========================================
# RGCBot - Environment Configuration Template
# ==========================================

# Telegram Bot API Token (from @BotFather)

# Operating Mode: "polling" or "webhook"
BOT_MODE=webhook

BOT_TOKEN=
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Super Admin Telegram User IDs (comma-separated integers)
BOT_SUPER_ADMINS=

# Database Configuration (PostgreSQL 16)
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (Queue & State Cache)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_QUEUE_KEY=rgcbot:ttl:queue
REDIS_RATE_LIMIT_PREFIX=rgcbot:ratelimit:

# Ephemeral Auto-Deletion Defaults (in seconds)
DEFAULT_MOD_TTL=15
DEFAULT_FUN_TTL=30
DEFAULT_RULES_TTL=45
DEFAULT_WARN_TTL=20
DEFAULT_GENERAL_TTL=30
SWEEPER_INTERVAL_SECONDS=1.5
SWEEPER_BATCH_SIZE=100

# Anti-Spam & Anti-Flood Defaults
DEFAULT_FLOOD_LIMIT=5
DEFAULT_FLOOD_WINDOW=3
DEFAULT_CAPTCHA_TIMEOUT=90

# Optional Global Logging Channel ID (for audit trail)
DEFAULT_LOG_CHANNEL_ID=

# MTProto Global User Resolution / Member Sync
# Used by src/services/mtproto_resolver.py and src/services/member_sync_service.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USER_SESSION_STRING=

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO