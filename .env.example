# ==========================================
# RGCBot - Environment Configuration Template
# ==========================================

# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Operating Mode: "polling" or "webhook"
BOT_MODE=polling

# Webhook Settings (Required only if BOT_MODE=webhook)
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=super_secret_webhook_token_32chars
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Super Admin Telegram User IDs (comma-separated integers)
BOT_SUPER_ADMINS=123456789,987654321

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rgcbot
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (Queue & State Cache)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_QUEUE_KEY=rgcbot:ttl:queue
REDIS_RATE_LIMIT_PREFIX=rgcbot:ratelimit:

# Ephemeral Auto-Deletion Defaults (in seconds)
DEFAULT_MOD_TTL=15
DEFAULT_FUN_TTL=30
DEFAULT_RULES_TTL=45
DEFAULT_WARN_TTL=20
DEFAULT_GENERAL_TTL=30
SWEEPER_INTERVAL_SECONDS=1.5
SWEEPER_BATCH_SIZE=100

# Anti-Spam & Anti-Flood Defaults
DEFAULT_FLOOD_LIMIT=5
DEFAULT_FLOOD_WINDOW=3
DEFAULT_CAPTCHA_TIMEOUT=90

# Optional Global Logging Channel ID (for audit trail)
DEFAULT_LOG_CHANNEL_ID=

# MTProto Global User Resolution (Optional Userbot StringSession for global @username bans)
PALANTIR_API_ID=
PALANTIR_API_HASH=
PALANTIR_STRING_SESSION=

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
